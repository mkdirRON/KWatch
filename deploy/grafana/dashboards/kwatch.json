{
  "uid": "kwatch-consumer-lag",
  "title": "KWatch \u00b7 Kafka Consumer Lag",
  "description": "Consumer lag per group, topic and partition, collected by KWatch.",
  "tags": [
    "kafka",
    "kwatch",
    "lag"
  ],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "10s",
      "30s",
      "1m",
      "5m",
      "15m",
      "1h"
    ]
  },
  "templating": {
    "list": [
      {
        "name": "group",
        "label": "Consumer group",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "kwatch-prometheus"
        },
        "description": "Filter to specific consumer groups.",
        "query": {
          "query": "label_values(kwatch_consumer_group_lag, group)",
          "refId": "group"
        },
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [],
        "sort": 1,
        "hide": 0
      },
      {
        "name": "topic",
        "label": "Topic",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "kwatch-prometheus"
        },
        "description": "Filter to specific topics.",
        "query": {
          "query": "label_values(kwatch_consumer_group_lag, topic)",
          "refId": "topic"
        },
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [],
        "sort": 1,
        "hide": 0
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "stat",
      "title": "Total lag",
      "id": 1,
      "datasource": {
        "type": "prometheus",
        "uid": "kwatch-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "kwatch-prometheus"
          },
          "editorMode": "code",
          "expr": "sum(kwatch_consumer_group_lag{group=~\"$group\", topic=~\"$topic\"})",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "#EAB839",
                "value": 10000
              },
              {
                "color": "red",
                "value": 100000
              }
            ]
          },
          "mappings": [],
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto",
        "orientation": "auto",
        "wideLayout": true
      }
    },
    {
      "type": "stat",
      "title": "Worst partition",
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "kwatch-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "kwatch-prometheus"
          },
          "editorMode": "code",
          "expr": "max(kwatch_consumer_group_lag{group=~\"$group\", topic=~\"$topic\"})",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "#EAB839",
                "value": 10000
              },
              {
                "color": "red",
                "value": 100000
              }
            ]
          },
          "mappings": [],
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto",
        "orientation": "auto",
        "wideLayout": true
      }
    },
    {
      "type": "stat",
      "title": "Consumer groups",
      "id": 3,
      "datasource": {
        "type": "prometheus",
        "uid": "kwatch-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "kwatch-prometheus"
          },
          "editorMode": "code",
          "expr": "count(count by (group) (kwatch_consumer_group_lag{group=~\"$group\", topic=~\"$topic\"}))",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "mappings": [],
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto",
        "orientation": "auto",
        "wideLayout": true
      }
    },
    {
      "type": "stat",
      "title": "Collection health",
      "id": 4,
      "datasource": {
        "type": "prometheus",
        "uid": "kwatch-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "kwatch-prometheus"
          },
          "editorMode": "code",
          "expr": "kwatch_up",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Kafka unreachable",
                  "index": 0
                },
                "1": {
                  "text": "Healthy",
                  "index": 1
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto",
        "orientation": "auto",
        "wideLayout": true
      }
    },
    {
      "type": "timeseries",
      "title": "Consumer lag by group",
      "id": 10,
      "datasource": {
        "type": "prometheus",
        "uid": "kwatch-prometheus"
      },
      "description": "Messages each consumer group is behind, summed across its partitions. A flat line is keeping up; a climbing line is falling behind.",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "kwatch-prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (group) (kwatch_consumer_group_lag{group=~\"$group\", topic=~\"$topic\"})",
          "refId": "A",
          "range": true,
          "instant": false,
          "legendFormat": "{{group}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "palette-classic-by-name"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "pointSize": 8,
            "showPoints": "never",
            "spanNulls": true,
            "lineInterpolation": "smooth",
            "gradientMode": "none",
            "axisLabel": "messages behind",
            "axisPlacement": "auto",
            "axisGridShow": true,
            "scaleDistribution": {
              "type": "linear"
            },
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            }
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Throughput: produced vs consumed",
      "id": 11,
      "datasource": {
        "type": "prometheus",
        "uid": "kwatch-prometheus"
      },
      "description": "Both series are messages per second on one axis. Consumed below produced is the cause of lag that is still growing.",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 13
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "kwatch-prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (topic) (rate(kwatch_topic_partition_end_offset{topic=~\"$topic\"}[5m]))",
          "refId": "A",
          "range": true,
          "instant": false,
          "legendFormat": "produced \u00b7 {{topic}}"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "kwatch-prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (topic) (rate(kwatch_consumer_group_committed_offset{group=~\"$group\", topic=~\"$topic\"}[5m]))",
          "refId": "B",
          "range": true,
          "instant": false,
          "legendFormat": "consumed \u00b7 {{topic}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "color": {
            "mode": "palette-classic-by-name"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "pointSize": 8,
            "showPoints": "never",
            "spanNulls": true,
            "lineInterpolation": "smooth",
            "gradientMode": "none",
            "axisLabel": "messages / sec",
            "axisPlacement": "auto",
            "axisGridShow": true,
            "scaleDistribution": {
              "type": "linear"
            },
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            }
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Worst partition lag by group",
      "id": 12,
      "datasource": {
        "type": "prometheus",
        "uid": "kwatch-prometheus"
      },
      "description": "A single hot partition is hidden by the summed view. This surfaces it.",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 13
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "kwatch-prometheus"
          },
          "editorMode": "code",
          "expr": "max by (group) (kwatch_consumer_group_lag{group=~\"$group\", topic=~\"$topic\"})",
          "refId": "A",
          "range": true,
          "instant": false,
          "legendFormat": "{{group}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "palette-classic-by-name"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "pointSize": 8,
            "showPoints": "never",
            "spanNulls": true,
            "lineInterpolation": "smooth",
            "gradientMode": "none",
            "axisLabel": "messages behind",
            "axisPlacement": "auto",
            "axisGridShow": true,
            "scaleDistribution": {
              "type": "linear"
            },
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            }
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      }
    },
    {
      "type": "table",
      "title": "Current lag by partition",
      "id": 13,
      "datasource": {
        "type": "prometheus",
        "uid": "kwatch-prometheus"
      },
      "description": "Instant view of every monitored group, topic and partition, worst lag first.",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 22
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "kwatch-prometheus"
          },
          "editorMode": "code",
          "expr": "kwatch_consumer_group_lag{group=~\"$group\", topic=~\"$topic\"}",
          "refId": "A",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true
            },
            "indexByName": {
              "group": 0,
              "topic": 1,
              "partition": 2,
              "Value": 3
            },
            "renameByName": {
              "group": "Group",
              "topic": "Topic",
              "partition": "Partition",
              "Value": "Lag"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [
              {
                "field": "Lag",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Lag"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "gradient"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "#EAB839",
                      "value": 10000
                    },
                    {
                      "color": "red",
                      "value": 100000
                    }
                  ]
                }
              },
              {
                "id": "custom.width",
                "value": 160
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Lag",
            "desc": true
          }
        ],
        "footer": {
          "show": true,
          "reducer": [
            "sum"
          ],
          "fields": [
            "Lag"
          ],
          "countRows": false
        }
      }
    }
  ]
